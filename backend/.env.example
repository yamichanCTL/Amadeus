# Copy to backend/.env and adapt only environment-specific values.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info
SECRET_KEY=change-me-in-production

# Relative paths are resolved independently of the shell working directory.
PROJECT_ROOT=..
FRONTEND_DESKTOP_DIR=../frontend/desktop
DATABASE_URL=sqlite+aiosqlite:///data/asr.db
MODELS_DIR=models
AUDIO_UPLOAD_DIR=data/uploads
TRANSCRIPT_DIR=data/transcripts
ARCHIVE_DIR=data/archive
TTS_DATA_DIR=tts

# Codex / CC Switch: source credentials are read locally, never sent by the client.
CODEX_BINARY=codex
# CODEX_CONFIG_HOME=/absolute/path/to/.codex
# CODEX_RUNTIME_DIR=/absolute/path/to/amadeus-codex
CODEX_MAX_SESSIONS=16
CODEX_MAX_ACTIVE_TURNS=2

# External source trees are environment-specific. Leave unused integrations empty.
SENSEVOICE_SRC_PATH=
FIREREDASR2_SRC_PATH=app/core/asr/engines/FireRedASR2S
GPT_SOVITS_DIR=

DEFAULT_ENGINE=sensevoice
DEFAULT_STREAM_ENGINE=x-asr
DEFAULT_SENSEVOICE_DEVICE=cuda:0
DEFAULT_FIREREDASR2_DEVICE=cuda
FIREREDASR2_MODEL_DIR=models/fireredasr2/FireRedASR2-AED

# FormalASR uses qwen-asr with separate Chinese speech-to-written-text weights.
# Select engine=formalasr in offline dictation; streaming remains a separate engine.
DEFAULT_FORMALASR_MODEL=TaurenMountain/FormalASR-1.7B
FORMALASR_MODEL_DIR=models/FormalASR-1.7B
DEFAULT_FORMALASR_DEVICE=cuda:0
FORMALASR_TORCH_DTYPE=bfloat16
FORMALASR_MAX_NEW_TOKENS=1024

# X-ASR model path is relative to backend/. Multiple CUDA roots use the OS path separator.
X_ASR_MODEL_DIR=../thirdparty/X-ASR/X-ASR-zh-en/deployment/models/chunk-960ms-model
DEFAULT_X_ASR_PROVIDER=cuda
X_ASR_CUDA_LIBRARY_PATH=
X_ASR_LIBSTDCPP_PATH=
X_ASR_ISOLATE_CUDA=true
X_ASR_WORKER_TIMEOUT_SEC=90

TRANSCRIBE_TIMEOUT_SEC=20
ASR_INFERENCE_SCHEDULER_ENABLED=true
ASR_INFERENCE_MAX_BATCH_ITEMS=4
ASR_INFERENCE_MAX_WAIT_MS=100
ASR_LONG_AUDIO_CHUNK_SEC=60
ALLOWED_ORIGINS=["*"]
# Optional full-duplex providers. Keep these blank until you choose a paid model.
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
# Standalone realtime API comparison probes (scripts/benchmark_realtime_apis.py).
STEPFUN_API_KEY=
# Native realtime voice providers. Keys stay on the backend; the desktop config
# panel can save these entries without restarting the service.
GEMINI_API_KEY=
BOSON_API_KEY=
XAI_API_KEY=
# Enable only after confirming free quota / explicit usage authorization.
GROK_EVAL_ENABLED=0
# Optional Qwen 3.7 reasoning; requires permission on the existing DashScope key.
QWEN_BRAIN_ENABLED=0
